# Dependencies and build outputs (rebuilt locally; never commit)
**/node_modules/
**/build/
**/.gradle/
**/dist/
mac/.build/
rust-core/target/
android/.kotlin/
android/local.properties
*.hprof
.DS_Store

# Post-commit audit artifacts. These are generated from a clean source commit;
# tracking them would make their declared source commit self-referential.
/artifacts/reader-debug.apk
/artifacts/reader-debug-androidTest.apk
/artifacts/reader-chrome-extension.zip
/artifacts/ARTIFACTS.json
/artifacts/SHA256SUMS
/artifacts/chrome-sbom.cdx.json
/artifacts/android-debug-runtime-dependencies.txt

# Local beta candidates and QA packages (hashes/evidence are tracked separately).
/artifacts/beta/
/artifacts/beta-qa/
/artifacts/beta-work/

/artifacts/recovery-checkpoint/

/artifacts/beta-0.9.0-beta.1/

# Local UI refresh packages and on-device screenshots.
/artifacts/ui-refresh/
