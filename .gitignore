# Dependencies and build outputs (rebuilt locally; never commit)
**/node_modules/
**/build/
**/.gradle/
**/dist/
mac/.build/
rust-core/target/
android/.kotlin/
android/local.properties
*.hprof
.DS_Store

# Generated packages and audit output. Keep source and evidence in Git; rebuild
# dependencies and packages locally instead of retaining every trial candidate.
/artifacts/**/*.apk
/artifacts/**/*.zip
/artifacts/ARTIFACTS.json
/artifacts/SHA256SUMS
/artifacts/chrome-sbom.cdx.json
/artifacts/android-debug-runtime-dependencies.txt
/artifacts/qa-runs/
/artifacts/**/chrome-profile/
/artifacts/**/tls-key.pem

# Live-web eval reports are regenerated on demand (see docs/eval/); only the
# URL list and the harness are tracked.
docs/eval/report-*.tsv
