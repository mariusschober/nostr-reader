"// Service worker: key ownership, outbox, pairing, quorum send, E2E ACK listen.
// Private keys never leave this scope. State is durable (storage.local +
// IndexedDB) because MV3 workers are suspended at will.
import { deflate } from \"pako\";
import { SimplePool } from \"nostr-tools/pool\";
import { finalizeEvent, getPublicKey } from \"nostr-tools/pure\";
import {
  READER_PROTOCOL, canonicalize, documentId, wordCount, syncSince, checkLimits,
} from \"../protocol/core.js\";
import { randomHex, randomSeckey, sealAndWrap, probeRelays, WRAP_KIND } from \"../nostr/transport.js\";
import { unwrapAndVerify } from \"../nostr/transport.js\";

const DEFAULT_RELAYS = [
  \"wss://relay.damus.io\",
  \"wss://nos.lol\",
  \"wss://relay.nostr.band\",
  \"wss://offchain.pub\",
];
const QUORUM = 2;

interface OutboxItem {
  transferId: string;
  documentId: string;
  title: string;
  manifest: Record<string, unknown>;
  chunks: string[]; // base64 gzip slices
  relays: string[];
  createdAt: number;
  status: \"pending\" | \"sent\" | \"acked\";
}

function hexToSeckey(hex: string): Uint8Array {
  const b = new Uint8Array(32);
  for (let i = 0; i < 32; i++) b[i] = parseInt(hex.slice(i * 2, i * 2 + 2), 16);
  return b;
}
function seckeyToHex(s: Uint8Array): string {
  return [...s].map((x) => x.toString(16).padStart(2, \"0\")).join(\"\");
}
function b64(bytes: Uint8Array): string {
  let s = \"\";
  for (const x of bytes) s += String.fromCharCode(x);
  return btoa(s);
}

async function getDeviceKey(): Promise<{ seckey: Uint8Array; pubkey: string }> {
  const st = await chrome.storage.local.get([\"deviceSeckey\"]);
  if (st.deviceSeckey) {
    const seckey = hexToSeckey(st.deviceSeckey as string);
    return { seckey, pubkey: getPublicKey(seckey) };
  }
  const seckey = randomSeckey();
  await chrome.storage.local.set({ deviceSeckey: seckeyToHex(seckey) });
  return { seckey, pubkey: getPublicKey(seckey) };
}

// ---- Outbox (IndexedDB, durable across worker restarts) ----
function idb(): Promise<IDBDatabase> {
  return new Promise((resolve, reject) => {
    const r = indexedDB.open(\"reader-outbox\", 1);
    r.onupgradeneeded = () => r.result.createObjectStore(\"items\", { keyPath: \"transferId\" });
    r.onsuccess = () => resolve(r.result);
    r.onerror = () => reject(r.error);
  });
}
async function outboxPut(item: OutboxItem): Promise<void> {
  const db = await idb();
  await new Promise<void>((res, rej) => {
    const tx = db.transaction(\"items\", \"readwrite\");
    tx.objectStore(\"items\").put(item as never);
    tx.oncomplete = () => res();
    tx.onerror = () => rej(tx.error);
  });
  db.close();
}
async function outboxAll(): Promise<OutboxItem[]> {
  const db = await idb();
  const items = await new Promise<OutboxItem[]>((res, rej) => {
    const q = db.transaction(\"items\").objectStore(\"items\").getAll();
    q.onsuccess = () => res(q.result as OutboxItem[]);
    q.onerror = () => rej(q.error);
  });
  db.close();
  return items;
}
async function outboxDelete(transferId: string): Promise<void> {
  const db = await idb();
  await new Promise<void>((res, rej) => {
    const tx = db.transaction(\"items\", \"readwrite\");
    tx.objectStore(\"items\").delete(transferId);
    tx.oncomplete = () => res();
    tx.onerror = () => rej(tx.error);
  });
  db.close();
}

// ---- Send pipeline ----
export async function queueCapture(raw: { title: string; markdown: string; sourceUrl?: string; sourceType?: string }): Promise<{ transferId: string; queued: boolean }> {
  const { seckey, pubkey } = await getDeviceKey();
  const canonical = canonicalize(raw.markdown);
  const docId = await documentId(canonical);
  const gz = deflate(new TextEncoder().encode(canonical));
  const st = await chrome.storage.local.get([\"channelPubkey\", \"relays\"]);
  const channelPubkey = st.channelPubkey as string | undefined;
  const relays = (st.relays as string[] | undefined) ?? DEFAULT_RELAYS.slice(0, 3);
  const now = Math.floor(Date.now() / 1000);
  // Adaptive chunk target: size real frames later; start 24 KiB of gzip.
  const SLICE = 24 * 1024;
  const chunks: string[] = [];
  for (let i = 0; i < gz.length; i += SLICE) chunks.push(b64(gz.slice(i, i + SLICE)));
  checkLimits({ compressedBytes: gz.length, titleLen: raw.title.length, urlLen: (raw.sourceUrl ?? \"\").length, chunkCount: chunks.length });
  const transferId = randomHex(16);
  const manifest = {
    protocol: READER_PROTOCOL, type: \"manifest\", transferId, documentId: docId,
    title: raw.title.slice(0, 500), sourceType: raw.sourceType ?? \"web\",
    sourceUrl: (raw.sourceUrl ?? \"\").slice(0, 2000), capturedAt: now,
    mime: \"text/markdown\", wordCount: wordCount(canonical),
    uncompressedBytes: new TextEncoder().encode(canonical).length,
    compressedBytes: gz.length,
    compressedSha256: await shaHex(gz), documentSha256: docId,
    chunkCount: chunks.length, senderDevicePubkey: pubkey, expiresAt: now + 7 * 86400,
  };
  const item: OutboxItem = { transferId, documentId: docId, title: raw.title, manifest, chunks, relays, createdAt: now, status: \"pending\" };
  await outboxPut(item);
  if (!channelPubkey) return { transferId, queued: true }; // unpaired: stays queued
  void publishTransfer(item, seckey, channelPubkey).catch(() => { /* alarm retries */ });
  return { transferId, queued: false };
}

async function shaHex(bytes: Uint8Array): Promise<string> {
  const d = await crypto.subtle.digest(\"SHA-256\", bytes as BufferSource);
  return [...new Uint8Array(d)].map((b) => b.toString(16).padStart(2, \"0\")).join(\"\");
}

async function publishTransfer(item: OutboxItem, seckey: Uint8Array, channelPubkey: string): Promise<void> {
  const pool = new SimplePool();
  const oks: string[] = [];
  const payloads: unknown[] = [item.manifest];
  item.chunks.forEach((dataBase64, index) => payloads.push({
    protocol: READER_PROTOCOL, type: \"chunk\", transferId: item.transferId,
    documentId: item.documentId, index, count: item.chunks.length, dataBase64,
  }));
  for (const payload of payloads) {
    const { wrap } = await sealAndWrap({ senderSeckey: seckey, recipientPubkey: channelPubkey, payload, wrapKind: WRAP_KIND });
    let ok = 0;
    await Promise.all(item.relays.map(async (url) => {
      try { await pool.publish([url], wrap as never); ok += 1; } catch { /* per-relay fail */ }
    }));
    if (ok >= Math.min(QUORUM, item.relays.length)) oks.push(\"chunk\");
  }
  pool.close(item.relays);
  if (oks.length === payloads.length) {
    item.status = \"sent\";
    await outboxPut(item);
  } else {
    throw new Error(\"relay quorum failed; will retry\");
  }
  void listenForAcks().catch(() => undefined);
}

// ---- E2E ACK listen (rolling window: NIP-59 timestamps are randomized) ----
async function listenForAcks(): Promise<void> {
  const st = await chrome.storage.local.get([\"deviceSeckey\", \"channelPubkey\", \"relays\"]);
  if (!st.deviceSeckey || !st.channelPubkey) return;
  const seckey = hexToSeckey(st.deviceSeckey as string);
  const pool = new SimplePool();
  const relays = (st.relays as string[] | undefined) ?? DEFAULT_RELAYS.slice(0, 3);
  const since = syncSince(Math.floor(Date.now() / 1000));
  const sub = pool.subscribeMany(relays, [{ kinds: [WRAP_KIND], \"#p\": [getPublicKey(seckey)], since }], {
    onevent: async (ev) => {
      try {
        const payload = await unwrapAndVerify({
          wrap: ev as never, recipientSeckey: seckey, expectedSenderPubkey: st.channelPubkey as string,
        });
        if (payload[\"type\"] === \"ack\" && (payload[\"status\"] === \"stored\" || payload[\"status\"] === \"duplicate\")) {
          await outboxDelete(payload[\"transferId\"] as string); // E2E ACK clears plaintext
        }
      } catch { /* hostile or unrelated event: ignore */ }
    },
  });
  setTimeout(() => { try { sub.close(); } catch { /* ignore */ } try { pool.close(relays); } catch { /* ignore */ } }, 60000);
}

// ---- Pairing ----
async function startPairing(): Promise<{ qr: Record<string, unknown> }> {
  const { pubkey } = await getDeviceKey();
  const pairingSeckey = randomSeckey();
  const nonce = randomHex(16);
  const st = await chrome.storage.local.get([\"relays\"]);
  const relays = (st.relays as string[] | undefined) ?? DEFAULT_RELAYS.slice(0, 3);
  const qr = {
    protocol: \"reader-pair/1\",
    pairingPubkey: getPublicKey(pairingSeckey),
    chromeDevicePubkey: pubkey,
    nonce,
    relays,
    expiresAt: Math.floor(Date.now() / 1000) + 300,
  };
  await chrome.storage.local.set({ pairingSeckey: seckeyToHex(pairingSeckey), pairingNonce: nonce });
  void waitPairingResponse().catch(() => undefined);
  return { qr };
}

async function waitPairingResponse(): Promise<void> {
  const st = await chrome.storage.local.get([\"pairingSeckey\", \"pairingNonce\", \"relays\"]);
  if (!st.pairingSeckey) return;
  const seckey = hexToSeckey(st.pairingSeckey as string);
  const pool = new SimplePool();
  const relays = (st.relays as string[] | undefined) ?? DEFAULT_RELAYS.slice(0, 3);
  const sub = pool.subscribeMany(relays, [{ kinds: [WRAP_KIND, 21059], \"#p\": [getPublicKey(seckey)], since: syncSince(Math.floor(Date.now() / 1000)) }], {
    onevent: async (ev) => {
      try {
        const { unwrapAndVerify: uv } = await import(\"../nostr/transport.js\");
        const p = await uv({ wrap: ev as never, recipientSeckey: seckey, expectedSenderPubkey: ev.pubkey });
        void p;
        // Pairing response is validated for nonce below by the UI flow; store nothing yet.
        void chrome.storage.local.set({ pairingResponse: ev });
      } catch { /* ignore */ }
    },
  });
  setTimeout(() => { try { sub.close(); } catch { /* ignore */ } try { pool.close(relays); } catch { /* ignore */ } }, 300000);
}

async function confirmPairing(resp: { androidPubkey: string; nonce: string }): Promise<boolean> {
  const st = await chrome.storage.local.get([\"pairingNonce\", \"pairingSeckey\"]);
  if (resp.nonce !== st.pairingNonce) return false;
  const health = await probeRelays(DEFAULT_RELAYS);
  const good = health.filter((h) => h.ok).slice(0, 3).map((h) => h.url);
  await chrome.storage.local.set({
    channelPubkey: resp.androidPubkey,
    relays: good.length >= 2 ? good : DEFAULT_RELAYS.slice(0, 3),
    pairingSeckey: null, pairingNonce: null,
  });
  // Retry any captures queued while unpaired.
  const items = await outboxAll();
  const { seckey } = await getDeviceKey();
  const ch = (await chrome.storage.local.get([\"channelPubkey\"])).channelPubkey as string;
  for (const it of items) void publishTransfer(it, seckey, ch).catch(() => undefined);
  return true;
}

// ---- Wiring ----
chrome.runtime.onMessage.addListener((msg, _sender, sendResponse) => {
  (async () => {
    if (msg?.kind === \"reader-capture\") {
      const r = await queueCapture(msg.doc);
      sendResponse({ ok: true, ...r });
    } else if (msg?.kind === \"reader-start-pairing\") {
      sendResponse({ ok: true, ...(await startPairing()) });
    } else if (msg?.kind === \"reader-confirm-pairing\") {
      sendResponse({ ok: await confirmPairing(msg.resp) });
    } else if (msg?.kind === \"reader-status\") {
      const st = await chrome.storage.local.get([\"channelPubkey\", \"relays\"]);
      const items = await outboxAll().catch(() => []);
      sendResponse({ ok: true, paired: !!st.channelPubkey, relays: st.relays ?? [], pending: items.length });
    } else if (msg?.kind === \"reader-retry\") {
      const items = await outboxAll();
      const { seckey } = await getDeviceKey();
      const ch = (await chrome.storage.local.get([\"channelPubkey\"])).channelPubkey as string | undefined;
      if (ch) for (const it of items) void publishTransfer(it, seckey, ch).catch(() => undefined);
      sendResponse({ ok: true, retried: items.length });
    }
  })().catch((e) => sendResponse({ ok: false, error: String(e).slice(0, 300) }));
  return true;
});

chrome.action.onClicked.addListener(async (tab) => {
  const st = await chrome.storage.local.get([\"channelPubkey\"]);
  if (!st.channelPubkey) {
    await chrome.tabs.create({ url: chrome.runtime.getURL(\"src/ui/pairing.html\") });
    return;
  }
  if (tab.id != null) {
    try {
      await chrome.tabs.sendMessage(tab.id, { kind: \"reader-capture-now\" });
      return;
    } catch { /* fall through to scripting */ }
  }
  if (tab.id != null) {
    try {
      await chrome.scripting.executeScript({ target: { tabId: tab.id }, files: [\"content.js\"] });
      await chrome.tabs.sendMessage(tab.id, { kind: \"reader-capture-now\" });
    } catch { /* offline or restricted page */ }
  }
});

chrome.alarms.create(\"reader-retry\", { periodInMinutes: 15 });
chrome.alarms.onAlarm.addListener(async (a) => {
  if (a.name !== \"reader-retry\") return;
  const items = await outboxAll().catch(() => []);
  if (!items.length) return;
  const st = await chrome.storage.local.get([\"channelPubkey\"]);
  if (!st.channelPubkey) return;
  const { seckey } = await getDeviceKey();
  for (const it of items.filter((i) => i.status === \"pending\")) {
    void publishTransfer(it, seckey, st.channelPubkey as string).catch(() => undefined);
  }
  void listenForAcks().catch(() => undefined);
});

chrome.runtime.onInstalled.addListener(() => {
  void getDeviceKey().catch(() => undefined);
  try { chrome.contextMenus.create({ id: \"reader-send-selection\", title: \"Send selection to Reader\", contexts: [\"selection\"] }); } catch { /* exists */ }
});
chrome.contextMenus.onClicked.addListener(async (info) => {
  if (info.menuItemId !== \"reader-send-selection\" || !info.selectionText) return;
  if (info.selectionText.trim().length < 10) return;
  await queueCapture({ title: \"Selection\", markdown: info.selectionText.trim() + \"\\n\", sourceType: \"selection\" }).catch(() => undefined);
});

// Keep an unused import referenced so the NIP-07 bridge split stays obvious.
void finalizeEvent;
