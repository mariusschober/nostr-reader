{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChannelDisconnectV2",
  "description": "Authenticated channel teardown. NIP-59 authenticates sender and recipient; no keys or content are included.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "type",
    "createdAt",
    "expiresAt",
    "reasonCode"
  ],
  "properties": {
    "protocol": { "const": "reader/2" },
    "type": { "const": "disconnect" },
    "createdAt": { "type": "integer" },
    "expiresAt": { "type": "integer" },
    "reasonCode": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" }
  }
}
