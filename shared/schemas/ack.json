{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EndpointAckV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "type",
    "transferId",
    "documentId",
    "manifestId",
    "contentHash",
    "senderChannelPubkey",
    "recipientDevicePubkey",
    "status",
    "receivedAt",
    "expiresAt"
  ],
  "properties": {
    "protocol": { "const": "reader/2" },
    "type": { "const": "ack" },
    "transferId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "documentId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifestId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "senderChannelPubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "recipientDevicePubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["stored", "duplicate", "rejected"] },
    "receivedAt": { "type": "integer" },
    "expiresAt": { "type": "integer" },
    "reasonCode": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" }
  }
}
