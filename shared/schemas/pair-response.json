{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReaderPairResponseV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "type",
    "sessionId",
    "nonce",
    "recipientPairingPubkey",
    "chromeDevicePubkey",
    "androidChannelPubkey",
    "relaySetDigest",
    "appVersion",
    "capabilities",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "protocol": { "const": "reader-pair/2" },
    "type": { "const": "pair-response" },
    "sessionId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "recipientPairingPubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chromeDevicePubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "androidChannelPubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relaySetDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "appVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" }
    },
    "createdAt": { "type": "integer" },
    "expiresAt": { "type": "integer" }
  }
}
